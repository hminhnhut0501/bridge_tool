# Local: HTTP loopback only. Production: HTTPS APP_URL + COOKIE_SECURE=true.
APP_PORT=8080
APP_URL=http://127.0.0.1:8080
COOKIE_SECURE=false
AUTH_USERNAME=admin
# Optional override. Otherwise run telegram-vault init-admin (Argon2id hash in DB).
AUTH_PASSWORD_HASH=
DATA_DIR=data
DATABASE_PATH=
TELEGRAM_MODE=real
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=
RCLONE_BINARY=rclone
RCLONE_CONFIG=
RCLONE_REMOTE=crypt:
# Keep TEST root until real Telegram/Google acceptance passes.
STORAGE_ROOT=TelegramVault_TEST
TRANSFER_MODE=stream
DOWNLOAD_CONCURRENCY=1
SCAN_BATCH_SIZE=100
TELEGRAM_REQUEST_PACE=0.5
MAX_DOWNLOAD_BANDWIDTH=1048576
MAX_UPLOAD_BANDWIDTH=1048576
MAX_RETRIES=6
RECONCILIATION_INTERVAL=300
VERIFY_SHA256=true

# Shared rest after a file is COMPLETED (seconds); UI can override.
FILE_PAUSE_ENABLED=true
FILE_PAUSE_MIN_SECONDS=5
FILE_PAUSE_MAX_SECONDS=60
