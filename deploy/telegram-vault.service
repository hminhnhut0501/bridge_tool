[Unit]
Description=Vault Bridge encrypted backup service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=telegram-vault
Group=telegram-vault
WorkingDirectory=/opt/telegram-vault
EnvironmentFile=/etc/telegram-vault/vault.env
ExecStart=/opt/telegram-vault/.venv/bin/telegram-vault serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telegram-vault
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
